server {
    server_name wecarehosting.com.br;
    return 301 https://www.wecarehosting.com.br$request_uri;

    listen 443 ssl; # managed by Certbot
    ssl_certificate /etc/letsencrypt/live/www.wecarehosting.com.br/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/www.wecarehosting.com.br/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot

}

server {
    server_name www.wecarehosting.com.br reserva.wecarehosting.com.br;

    client_max_body_size 2m;

    # APIs que falam com o Hostaway/InfinitePay: mesmo teto que existia no WAF (20 req/min por IP)
    location /api/reservas/ {
        limit_req zone=wecare_api burst=10 nodelay;
        limit_req_status 429;
        proxy_pass http://127.0.0.1:3010;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 320s;
    }
    location /api/infinitepay/ {
        limit_req zone=wecare_api burst=10 nodelay;
        limit_req_status 429;
        proxy_pass http://127.0.0.1:3010;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
    location / {
        proxy_pass http://127.0.0.1:3010;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }

    listen 443 ssl; # managed by Certbot
    ssl_certificate /etc/letsencrypt/live/www.wecarehosting.com.br/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/www.wecarehosting.com.br/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot


}


server {
    if ($host = reserva.wecarehosting.com.br) {
        return 301 https://$host$request_uri;
    } # managed by Certbot


    if ($host = www.wecarehosting.com.br) {
        return 301 https://$host$request_uri;
    } # managed by Certbot


    listen 80;
    server_name www.wecarehosting.com.br reserva.wecarehosting.com.br;
    return 404; # managed by Certbot




}server {
    if ($host = wecarehosting.com.br) {
        return 301 https://$host$request_uri;
    } # managed by Certbot


    listen 80;
    server_name wecarehosting.com.br;
    return 404; # managed by Certbot


}