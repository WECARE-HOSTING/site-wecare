[Unit]
Description=WeCare site (Next.js standalone) - www.wecarehosting.com.br
After=network.target

[Service]
User=wecaresite
Group=wecaresite
WorkingDirectory=/srv/wecare-site/current
EnvironmentFile=/etc/wecare-site.env
Environment=NODE_ENV=production
Environment=PORT=3010
Environment=HOSTNAME=127.0.0.1
Environment=NEXT_TELEMETRY_DISABLED=1
ExecStart=/usr/bin/node server.js
Restart=always
RestartSec=3
# O servidor é compartilhado com outros sistemas: este serviço não pode tomar a máquina.
MemoryHigh=900M
MemoryMax=1200M
CPUWeight=60
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/srv/wecare-site/cache

[Install]
WantedBy=multi-user.target
